
// Example CRUD Operations in AQL

/// CREATE
// Create a new user
INSERT {
    "version": 1,
    "user_name": "A",
    "user_last_name": "Aa",
    "user_email": "a@example.com",
    "user_password": "password1",
    "phones": [
    "+4522334455"
    ],
    "addresses": [
    {
        "address_line": "Street 1, City A",
        "postal_code": "1000",
        "primary_address": true
    }
    ],
    "roles": [
    "customer"
    ],
    "user_created_at": DATE_NOW(),
    "user_deleted_at": 0,
    "user_blocked_at": 0,
    "user_updated_at": 0,
    "user_verified_at": DATE_NOW(),
    "user_verification_key": CONCAT("verify_", UUID()),
} INTO users

// Create a new item
INSERT {
    "_key": "item_1",
    "item_title": "Pizza",
    "item_price": 12.99,
    "item_image": "pizza.png",
    "item_created_at": DATE_NOW(),
    "item_deleted_at": 0
} INTO items


// Create a new order
INSERT {
    "version": 1,
    "customer": {
        "user_key": "user_1",
        "user_name": "A",
        "delivery_address": {
        "address_line": "street 1, City A",
        "postal_code": "1000",
        },
        "phones": [
        "+4512131415"
        ]
    },
    "restaurant": {
        "user_key": "user_3",
        "restaurant_name": "C",
        "restaurant_address": {
        "address_line": "street 3,  City C",
        "postal_code": "3000"
        },
        "phones": [
        "+4512131415"
        ]
    },
    "order_total_price": 24.98,
    "order_status": "pending",
    "order_created_at": DATE_NOW(),
    "order_items": [
        {
        "item_key": "item_1",
        "item_quantity": 2,
        "item_price": 12.99,
        "item_title": "Pizza"
        }
    ]
} INTO orders



/// READ
// Get all users
FOR user IN users
    RETURN user

// Get user by _key
FOR user IN users
    RETURN user

// Get user by email
FOR user IN users
    FILTER user.user_email == "a@example.com"
    RETURN user

// Get user with their items by _key
FOR user IN users
    FILTER user._key == "user_2"
    RETURN {
        user_name: user.user_name,
        items: user.items
    }

// Get all users with a specific role
FOR user IN users
    FILTER LENGTH(
        FOR role IN user.roles
        FILTER role.role_name == "admin"
        RETURN 1
    ) > 0
    RETURN user



/// UPDATE
// Update user's name 
UPDATE "user_1" WITH { 
    user_name: "UpdatedName",
    user_updated_at: DATE_NOW()
} IN users

// Add new phone number to user 
UPDATE "user_1" WITH { 
    "user_name": "UpdatedName",
    "user_updated_at": DATE_NOW(),
    "phones": APPEND("user_1".phones, "+4599999999", true)
} IN users

// Update/add items in user 
UPDATE "user_2" WITH {
    "items": APPEND("user_2".items, "item_3", true),
    "user_updated_at": DATE_NOW()
} IN users




/// DELETE 
// Soft delete (setting deleted timestamp)
UPDATE "user_1" WITH {
    user_deleted_at: DATE_NOW(),
    user_updated_at: DATE_NOW(),
} IN users

// Hard delete (removing document)
REMOVE "user_5" IN users

// Remove specific item from user's items array
UPDATE "user_2" WITH {
    items: REMOVE_VALUE("user_2".items, "item_2")
} IN users

